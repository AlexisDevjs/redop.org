---
interface Props {
	lines: string[];
	as?: "h1" | "h2" | "h3" | "p" | "span";
	id?: string;
	class?: string;
	/** Stagger between words, in seconds. */
	stagger?: number;
}

const { lines, as: Tag = "h2", id, class: className, stagger } = Astro.props;

const label = lines.join(" ");
---

<Tag
	id={id}
	class:list={["split", className]}
	data-split
	data-split-stagger={stagger}
	aria-label={label}
>
	{
		lines.map((line) => (
			<span class="split-line" aria-hidden="true">
				{line
					.split(/\s+/)
					.filter(Boolean)
					.map((word) => (
						<Fragment>
							<span class="split-word">
								<span>{word}</span>
							</span>{" "}
						</Fragment>
					))}
			</span>
		))
	}
</Tag>
