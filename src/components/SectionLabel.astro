---
interface Props {
	class?: string;
	tone?: "red" | "green" | "purple";
}
const { class: className, tone = "red" } = Astro.props;
const dot =
	tone === "green"
		? "bg-accent-green"
		: tone === "purple"
			? "bg-accent-purple"
			: "bg-accent-red";
---
<span class:list={['mb-5.25 inline-flex items-center gap-2 text-[11px] font-semibold text-muted', className]}>
  <span class:list={["size-1.5 rounded-xs", dot]} aria-hidden="true"></span><slot />
</span>
