---
const year = new Date().getFullYear();
---
<footer
  class="site-container flex min-h-28.75 items-center justify-between gap-7.5 pb-5 max-md:grid max-md:grid-cols-[1fr_auto] max-md:gap-3.75 max-md:pt-0 max-md:pb-6.25"
>
  <a
    href="/#inicio"
    class="font-display text-[19px] leading-[1.2] font-bold tracking-[1px]"
    aria-label="REDOPS, inicio"
  >
    REDOPS
    <span
      class="mt-1.25 block font-sans text-[9px] font-normal tracking-[1px] text-muted"
    >
      Cybersecurity
    </span>
  </a>
  <p
    class="text-[10px] text-muted max-md:col-span-full max-md:row-start-2 max-md:text-[9px]"
  >
    © {year} REDOPS. Seguridad en cada conexión.
  </p>
  <a
    class="flex min-h-11 items-center gap-6.25 text-[10px] text-muted hover:text-content max-md:col-start-2 max-md:row-start-1"
    href="#inicio">Volver arriba <span aria-hidden="true">↑</span></a
  >
</footer>
