---
const year = new Date().getFullYear();
---
<footer
  class="site-container flex min-h-28.75 items-center justify-between gap-7.5 pb-5 max-[760px]:grid max-[760px]:grid-cols-[1fr_auto] max-[760px]:gap-3.75 max-[760px]:pt-0 max-[760px]:pb-6.25"
>
  <a
    href="/#inicio"
    class="font-display text-[19px] leading-[1.2] font-bold tracking-[1px]"
    aria-label="REDOPS, inicio"
  >
    REDOPS
    <span
      class="mt-1.25 block font-sans text-[9px] font-normal tracking-[1px] text-muted"
    >
      Cybersecurity
    </span>
  </a>
  <p
    class="text-[10px] text-muted max-[760px]:col-span-full max-[760px]:row-start-2 max-[760px]:text-[9px]"
  >
    © {year} REDOPS. Seguridad en cada conexión.
  </p>
  <a
    class="flex min-h-11 items-center gap-6.25 text-[10px] text-muted hover:text-content max-[760px]:col-start-2 max-[760px]:row-start-1"
    href="#inicio">Volver arriba <span aria-hidden="true">↑</span></a
  >
</footer>
