---
const year = new Date().getFullYear();
---
<footer
  class="site-container grid min-h-28.75 grid-cols-[1fr_auto] items-center justify-between gap-3.75 pt-0 pb-6.25 md:flex md:gap-7.5 md:pt-0 md:pb-5"
>
  <a
    href="/#inicio"
    class="font-display text-[19px] leading-[1.2] font-bold tracking-[1px]"
    aria-label="REDOPS, inicio"
  >
    REDOPS
    <span
      class="mt-1.25 block font-sans text-[9px] font-normal tracking-[1px] text-muted"
    >
      Cybersecurity
    </span>
  </a>
  <p
    class="col-span-full row-start-2 text-[9px] text-muted md:col-auto md:row-auto md:text-[10px]"
  >
    © {year} REDOPS. Seguridad en cada conexión.
  </p>
  <a
    class="col-start-2 row-start-1 flex min-h-11 items-center gap-6.25 text-[10px] text-muted hover:text-content md:col-auto md:row-auto"
    href="#inicio">Volver arriba <span aria-hidden="true">↑</span></a
  >
</footer>
