---
import Button from "./Button.astro";
import Icon from "./Icon.astro";

const isGallery = Astro.url.pathname.startsWith("/galeria");
const links = [
	{ href: "/#nosotros", label: "Nosotros" },
	{ href: "/#servicios", label: "Servicios" },
	{ href: "/galeria", label: "Galería" },
];
---

<header
  data-header
  class="sticky top-0 z-50 border-b border-outline bg-header md:backdrop-blur-md"
>
  <div
    class="site-container relative flex h-22 items-center justify-between gap-2.5 md:gap-6.25"
  >
    <a
      href="/"
      class="relative z-10 flex h-full items-center gap-2.5 font-display text-xl leading-none font-bold tracking-[1px] md:text-[23px]"
      aria-label="REDOPS, inicio"
    >
      <img
        src="/brand/redops-header-light.png"
        alt=""
        loading="eager"
        fetchpriority="high"
        class="h-full w-auto dark:hidden"
      />
      <img
        src="/brand/redops-header-transparent.png"
        alt=""
        loading="eager"
        fetchpriority="high"
        class="hidden h-full w-auto dark:block"
      />
    </a>

    <nav id="main-nav" aria-label="Navegación principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={
              link.href === "/galeria" && isGallery ? "page" : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
      <Button href="/#contacto" size="small" class="menu-cta"
        >Cotizar proyecto <Icon name="arrow" size={17} /></Button
      >
    </nav>

    <div class="relative z-10 flex items-center gap-2 md:gap-3">
      <button
        id="theme-toggle"
        class="inline-flex size-11 items-center justify-center rounded-[7px] border border-outline bg-transparent text-content hover:bg-raised"
        aria-label="Activar modo claro"
        title="Cambiar tema"
      >
        <span class="hidden dark:flex"><Icon name="sun" size={20} /></span>
        <span class="flex dark:hidden"><Icon name="moon" size={20} /></span>
      </button>
      <span class="hidden md:block">
        <Button href="/#contacto" size="small"
          >Cotizar proyecto <Icon name="arrow" size={17} /></Button
        >
      </span>
      <button
        id="menu-toggle"
        class="inline-flex size-11 items-center justify-center rounded-[7px] border border-outline bg-transparent text-content hover:bg-raised md:hidden"
        aria-controls="main-nav"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span class="menu-icon-open flex"><Icon name="menu" /></span>
        <span class="menu-icon-close"><Icon name="close" /></span>
      </button>
    </div>
  </div>
</header>
