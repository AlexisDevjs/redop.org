---
import Button from "./Button.astro";
import Icon from "./Icon.astro";

const isGallery = Astro.url.pathname.startsWith("/galeria");
---

<header
  class="sticky top-0 z-20 border-b border-outline bg-header backdrop-blur-md"
>
  <div
    class="site-container flex min-h-22 items-center justify-between gap-6.25 max-md:min-h-18.5 max-md:gap-2.5"
  >
    <a
      href="/"
      class="flex items-center gap-2.5 font-display text-[23px] leading-none font-bold tracking-[1px] max-md:text-xl"
      aria-label="REDOPS, inicio"
    >
      <div
        class="size-11 shrink-0 overflow-hidden rounded-[5px] bg-[#080808] max-md:size-9.5"
      >
        <img
          src="/brand/redops-header.webp"
          alt=""
          loading="eager"
          fetchpriority="high"
          class="h-full w-auto"
        />
      </div>
    </a>

    <nav
      id="main-nav"
      aria-label="Navegación principal"
      class="flex items-center gap-8.75 text-sm max-lg:gap-6 max-md:absolute max-md:inset-x-0 max-md:top-18.25 max-md:hidden max-md:border-b max-md:border-outline max-md:bg-surface max-md:px-5 max-md:py-3.75 max-md:[&.open]:grid max-md:[&.open]:gap-0 [&_a]:py-3.5 [&_a]:text-muted [&_a:hover]:text-content max-md:[&_a]:p-3.5 max-md:[&_a]:text-sm"
    >
      <a href="/#nosotros">Nosotros</a>
      <a href="/#servicios">Servicios</a>
      <a
        href="/galeria"
        aria-current={isGallery ? "page" : undefined}
        class="aria-[current=page]:text-accent-red">Galería</a
      >
    </nav>

    <div class="flex items-center gap-3 max-md:gap-2">
      <button
        id="theme-toggle"
        class="inline-flex size-11 items-center justify-center rounded-[7px] border border-outline bg-transparent text-content hover:bg-raised"
        aria-label="Activar modo claro"
        title="Cambiar tema"
      >
        <span class="hidden dark:flex"><Icon name="sun" size={20} /></span>
        <span class="flex dark:hidden"><Icon name="moon" size={20} /></span>
      </button>
      <Button href="/#contacto" size="small" class="max-md:hidden"
        >Cotizar proyecto <Icon name="arrow" size={17} /></Button
      >
      <button
        id="menu-toggle"
        class="hidden size-11 items-center justify-center rounded-[7px] border border-outline bg-transparent text-content hover:bg-raised max-md:inline-flex"
        aria-controls="main-nav"
        aria-expanded="false"
        aria-label="Abrir menú"><Icon name="menu" /></button
      >
    </div>
  </div>
</header>
