---
import BrandNetwork from "../components/BrandNetwork.astro";
import Button from "../components/Button.astro";
import Dialogs from "../components/Dialogs.astro";
import Footer from "../components/Footer.astro";
import Gallery from "../components/Gallery.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ServiceGraphic from "../components/ServiceGraphic.astro";
import Layout from "../layouts/Layout.astro";

const areas = [
	{
		icon: "camera",
		iconColor: "text-accent-red",
		title: "Videovigilancia inteligente",
		text: "Instalación de cámaras y sistemas de videovigilancia para tener una mejor visión de lo que importa.",
	},
	{
		icon: "shield",
		iconColor: "text-accent-green",
		title: "Seguridad digital",
		text: "Seguridad de redes y revisión ética de la protección de tus cuentas y redes sociales.",
	},
	{
		icon: "tools",
		iconColor: "text-accent-purple",
		title: "Instalaciones y acabados",
		text: "Obra civil, canalización y pintura para integrar la red y ocultar el cableado de tus cámaras.",
	},
];

const disciplines = [
	"Videovigilancia",
	"Seguridad de redes",
	"Hacking ético",
	"Obra civil",
	"Instalaciones y pintura",
];

const services = [
	"Cámaras y sistemas inteligentes de videovigilancia.",
	"Seguridad de redes y revisión ética de cuentas.",
	"Obra civil, cableado oculto y pintura de acabados.",
];
---

<Layout>
  <a
    class="fixed -top-25 left-5 z-100 bg-surface px-4.5 py-3 focus:top-3"
    href="#contenido"
    >Saltar al contenido
  </a>

  <Header />

  <main id="contenido">
    <section
      class="relative isolate overflow-hidden"
      id="inicio"
      aria-labelledby="hero-title"
    >
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-wash" aria-hidden="true"></div>
      <div
        class="site-container grid min-h-160 grid-cols-[1.1fr_1fr] items-center gap-3 pt-16.25 pb-11 2xl:min-h-180 max-lg:min-h-142.5 max-lg:pt-12.5 max-lg:pb-7.5 max-md:grid-cols-1 max-md:gap-0 max-md:pt-11.25"
      >
        <div class="relative z-2 lg:motion-safe:animate-hero-copy">
          <h1
            id="hero-title"
            class="mb-6.5 text-[clamp(48px,5.5vw,75px)] leading-[1.07] font-medium tracking-[-3.8px] 2xl:text-[79px] max-lg:text-[59px] max-md:mb-5.5 max-md:text-[clamp(43px,8.5vw,63px)] max-md:tracking-[-2.6px]"
          >
            Tu seguridad.<br />En cada conexión.
          </h1>
          <p
            class="max-w-107.5 text-[15px] leading-[1.85] max-lg:text-sm"
          >
            Cámaras inteligentes, redes seguras e instalaciones bien hechas.
            Integramos tecnología y experiencia para proteger tu espacio y tu
            vida digital.
          </p>
          <div
            class="mt-8 flex items-center gap-6.25 max-lg:flex-wrap max-lg:gap-3.5 max-md:mt-6.5 max-md:gap-5"
          >
            <Button href="#servicios"
              >Explora nuestros servicios <Icon
                name="arrow"
                size={19}
              /></Button
            >
            <a
              class="flex min-h-11 items-center gap-1.75 text-[12px] font-semibold hover:text-accent-red"
              href="#nosotros"
              >Conoce REDOPS <Icon name="chevron" size={17} /></a
            >
          </div>
          <div
            class="mt-8.5 flex items-center gap-3 text-[10px] text-muted max-md:mt-6"
          >
            <span class="flex pl-px" aria-hidden="true"
              >{
                ["bg-brand", "bg-accent-green", "bg-accent-purple"].map(
                  (color) => (
                    <i
                      class:list={[
                        "-ml-0.75 size-4.25 rounded-full border-[3px] border-page",
                        color,
                      ]}
                    />
                  ),
                )
              }</span
            >
            Del primer cable al último detalle.
          </div>
        </div>
        <BrandNetwork />
      </div>
      <div
        class="site-container flex items-center justify-between pt-3.75 pb-6 text-[10px] text-muted max-md:gap-3.75 max-md:pt-0 max-md:pb-3.75 max-md:text-[9px]"
      >
        <span class="max-md:max-w-37.5"
          >Protección digital. Presencia en el mundo real.</span
        >
        <a
          class="flex min-h-11 items-center gap-6.25 hover:text-content max-md:gap-2.5 max-md:whitespace-nowrap"
          href="#nosotros"
          >Descubre lo que hacemos <span class="text-xl" aria-hidden="true"
            >↓</span
          ></a
        >
      </div>
    </section>

    <div class="border-y border-outline bg-surface">
      <div
        class="site-container flex min-h-18 items-center justify-between gap-4.5 font-display text-[13px] text-muted max-md:min-h-20 max-md:flex-wrap max-md:justify-center max-md:gap-x-3.75 max-md:gap-y-2 max-md:py-5 max-md:text-[11px]"
      >
        {
          disciplines.map((discipline, index) => (
            <>
              <span>{discipline}</span>
              {index < disciplines.length - 1 && (
                <i
                  class:list={[
                    "size-1 shrink-0 rounded-full bg-accent-red",
                    index === 2 && "max-md:hidden",
                  ]}
                  aria-hidden="true"
                />
              )}
            </>
          ))
        }
      </div>
    </div>

    <section
      class="site-container grid grid-cols-2 gap-x-22.5 gap-y-14 py-27 max-lg:gap-x-11.25 max-md:grid-cols-1 max-md:gap-y-7 max-md:py-17.5"
      id="nosotros"
      aria-labelledby="about-title"
    >
      <div>
        <SectionLabel>Somos REDOPS</SectionLabel><h2 id="about-title">
          La tranquilidad empieza<br />con una buena instalación.
        </h2>
      </div>
      <div class="pt-2.25 text-[13px] leading-[1.9] max-md:pt-0">
        <p
          class="mb-4 text-[19px] leading-normal text-content max-md:text-lg"
        >
          Tecnología que protege. Trabajo que se nota.
        </p>
        <p class="mt-3.25">
          En REDOPS conectamos la seguridad física con la digital. Instalamos
          sistemas de videovigilancia, trabajamos en la protección de redes y
          cuidamos la infraestructura que hace posible cada conexión.
        </p>
        <p class="mt-3.25">
          Nos ocupamos también de lo que no se ve: canalización, cableado y
          acabados para una instalación integrada a tu espacio.
        </p>
        <div
          class="mt-6 flex items-center gap-6.25 font-display text-[19px] font-bold text-content max-md:mt-5.25"
        >
          <small class="font-sans text-[10px] font-normal text-muted"
            >Trabajamos con</small
          ><span>HIKVISION</span><span>UNV</span>
        </div>
      </div>
      <div
        class="col-span-full grid grid-cols-3 gap-8 max-md:mt-2.5 max-md:grid-cols-1 max-md:gap-7"
      >
        {
          areas.map((area) => (
            <article class="border-t border-outline pt-7 max-md:grid max-md:grid-cols-[50px_1fr] max-md:gap-x-4.5 max-md:gap-y-2 max-md:pt-6.25">
              <span
                class:list={[
                  "mb-5.5 flex size-12.75 items-center justify-center rounded-[10px] border border-outline bg-surface max-md:row-span-2 max-md:m-0 max-md:size-11.25",
                  area.iconColor,
                ]}
              >
                <Icon name={area.icon} size={26} />
              </span>
              <h3 class="mb-3 text-[19px] max-md:m-0">{area.title}</h3>
              <p class="max-w-77.5 text-[13px] leading-[1.85] max-md:max-w-none">
                {area.text}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="border-y border-outline bg-surface"
      id="servicios"
      aria-labelledby="services-title"
    >
      <div
        class="site-container grid grid-cols-2 items-center gap-18.75 py-20 max-lg:gap-7.5 max-md:grid-cols-1 max-md:gap-8.75 max-md:py-13.75"
      >
        <ServiceGraphic />
        <div>
          <SectionLabel>Una solución de principio a fin</SectionLabel>
          <h2
            id="services-title"
            class="text-[clamp(30px,3.2vw,42px)] max-md:text-[34px]"
          >
            Protegemos lo importante.<br />Cuidamos los detalles.
          </h2>
          <p class="mt-5.75 max-w-110 text-[13px] leading-[1.9]">
            Una cámara es parte de un sistema. La red, el cableado y la
            instalación también cuentan. Trabajamos en cada parte para que todo
            encaje.
          </p>
          <ul class="mt-6 mb-7.25 grid list-none gap-3.5 p-0">
            {
              services.map((service) => (
                <li class="flex items-center gap-2.5 text-[12px] text-muted max-md:items-start max-md:leading-[1.7]">
                  <span class="text-accent-green max-md:mt-0.5">
                    <Icon name="check" size={18} />
                  </span>
                  {service}
                </li>
              ))
            }
          </ul>
          <Button href="#contacto" variant="secondary"
            >Hablemos de tu proyecto <Icon name="arrow" size={18} /></Button
          >
        </div>
      </div>
    </section>

    <Gallery />

    <section
      class="contact-glow site-container mb-15 rounded-2xl border px-11 pt-8.5 pb-5.5 max-md:mb-8.75 max-md:rounded-xl max-md:px-6 max-md:pt-6.75 max-md:pb-5"
      id="contacto"
      aria-labelledby="contact-title"
    >
      <div class="flex items-start justify-between text-accent-red">
        <SectionLabel class="max-md:text-[10px]">
          Cuéntanos qué necesitas proteger
        </SectionLabel>
        <Icon name="globe" size={31} />
      </div>
      <div
        class="grid grid-cols-[1.2fr_1fr] items-center gap-16.25 pt-3.75 pb-9.25 max-lg:gap-8.75 max-md:grid-cols-1 max-md:gap-6 max-md:pt-3 max-md:pb-7.5"
      >
        <h2
          id="contact-title"
          class="text-[clamp(34px,4vw,50px)] tracking-[-2px] max-md:text-[35px] max-md:tracking-[-1.5px]"
        >
          Tu próximo proyecto.<br />Más seguro desde el inicio.
        </h2>
        <div>
          <p
            class="mb-5.75 max-w-87.5 text-[13px] leading-[1.9] max-md:max-w-none"
          >
            ¿Necesitas cámaras, mejorar la seguridad de tu red o una instalación
            completa? Cuéntanos tu idea y conversemos sobre la solución.
          </p>
          <Button id="contact-open">
            Solicitar información <Icon name="arrow" size={19} />
          </Button>
        </div>
      </div>
      <div
        class="flex items-center justify-between border-t border-outline pt-4.75 text-[10px] text-muted max-md:gap-3.75 max-md:text-[9px]"
      >
        <span>Videovigilancia. Redes. Instalaciones.</span>
        <span>redop.org</span>
      </div>
    </section>
  </main>

  <Footer />
  <Dialogs />
  <script src="../scripts/interactions.ts"></script>
</Layout>
