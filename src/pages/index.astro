---
import { Image } from "astro:assets";
import expertImage from "../assets/images/experto-proyectos-tecnologicos.png";
import BrandNetwork from "../components/BrandNetwork.astro";
import Button from "../components/Button.astro";
import Dialogs from "../components/Dialogs.astro";
import Footer from "../components/Footer.astro";
import Gallery from "../components/Gallery.astro";
import Header from "../components/Header.astro";
import Icon from "../components/Icon.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ServiceGraphic from "../components/ServiceGraphic.astro";
import SplitText from "../components/SplitText.astro";
import Layout from "../layouts/Layout.astro";

const areas = [
	{
		icon: "camera",
		iconColor: "text-accent-red",
		title: "Videovigilancia inteligente",
		text: "Instalación de cámaras y sistemas de videovigilancia para tener una mejor visión de lo que importa.",
	},
	{
		icon: "shield",
		iconColor: "text-accent-green",
		title: "Seguridad digital",
		text: "Seguridad de redes y revisión ética de la protección de tus cuentas y redes sociales.",
	},
	{
		icon: "tools",
		iconColor: "text-accent-purple",
		title: "Instalaciones y acabados",
		text: "Obra civil, canalización y pintura para integrar la red y ocultar el cableado de tus cámaras.",
	},
];

const disciplines = [
	{
		title: "Vigilancia inteligente",
		text: "Cámaras, monitoreo y control del perímetro.",
	},
	{
		title: "Redes protegidas",
		text: "Conexiones seguras para cada operación.",
	},
	{
		title: "Evaluación ética",
		text: "Revisión responsable de cuentas y redes.",
	},
	{
		title: "Infraestructura integrada",
		text: "Obra civil y canalización para cada instalación.",
	},
	{
		title: "Acabados limpios",
		text: "Cableado oculto y pintura que respeta el espacio.",
	},
];

const services = [
	"Cámaras y sistemas inteligentes de videovigilancia.",
	"Seguridad de redes y revisión ética de cuentas.",
	"Obra civil, cableado oculto y pintura de acabados.",
];
---

<Layout>
  <a
    class="fixed -top-25 left-5 z-100 bg-surface px-4.5 py-3 focus:top-3"
    href="#contenido"
    >Saltar al contenido
  </a>

  <Header />

  <main id="contenido">
    <section
      class="relative isolate overflow-hidden"
      id="inicio"
      aria-labelledby="hero-title"
    >
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-wash" aria-hidden="true"></div>
      <div
        class="site-container grid min-h-142.5 grid-cols-1 items-center gap-0 pt-11.25 pb-7.5 md:gap-3 md:pt-12.5 lg:min-h-160 lg:grid-cols-[1.1fr_1fr] lg:pt-16.25 lg:pb-11 2xl:min-h-180"
      >
        <div class="relative z-2">
          <SplitText
            as="h1"
            id="hero-title"
            lines={["Tu seguridad.", "En cada conexión."]}
            class="mb-5.5 text-[clamp(43px,8.5vw,63px)] leading-[1.07] font-medium tracking-[-2.6px] md:text-[59px] lg:mb-6.5 lg:text-[clamp(48px,5.5vw,75px)] lg:tracking-[-3.8px] 2xl:text-[79px]"
          />
          <p
            class="max-w-107.5 text-sm leading-[1.85] lg:text-[15px]"
            data-reveal
          >
            Cámaras inteligentes, redes seguras e instalaciones bien hechas.
            Integramos tecnología y experiencia para proteger tu espacio y tu
            vida digital.
          </p>
          <div
            class="mt-6.5 flex flex-wrap items-center gap-5 md:gap-3.5 lg:mt-8 lg:flex-nowrap lg:gap-6.25"
            data-reveal
          >
            <Button href="#servicios"
              >Explora nuestros servicios <Icon
                name="arrow"
                size={19}
              /></Button
            >
            <a
              class="flex min-h-11 items-center gap-1.75 text-[12px] font-semibold hover:text-accent-red"
              href="#nosotros"
              >Conoce REDOPS <Icon name="chevron" size={17} /></a
            >
          </div>
          <div
            class="mt-6 flex items-center gap-3 text-[10px] text-muted lg:mt-8.5"
            data-reveal
          >
            <span class="flex pl-px" aria-hidden="true"
              >{
                ["bg-brand", "bg-accent-green", "bg-accent-purple"].map(
                  (color) => (
                    <i
                      class:list={[
                        "-ml-0.75 size-4.25 rounded-full border-[3px] border-page",
                        color,
                      ]}
                    />
                  ),
                )
              }</span
            >
            Del primer cable al último detalle.
          </div>
        </div>
        <BrandNetwork />
      </div>
      <div
        class="site-container flex items-center justify-between gap-3.75 pt-0 pb-3.75 text-[9px] text-muted lg:gap-0 lg:pt-3.75 lg:pb-6 lg:text-[10px]"
        data-reveal
      >
        <span class="max-w-37.5 lg:max-w-none"
          >Protección digital. Presencia en el mundo real.</span
        >
        <a
          class="flex min-h-11 items-center gap-2.5 whitespace-nowrap hover:text-content lg:gap-6.25 lg:whitespace-normal"
          href="#nosotros"
          >Descubre lo que hacemos <span class="text-xl" aria-hidden="true"
            >↓</span
          ></a
        >
      </div>
    </section>

    <section
      class="border-y border-outline bg-surface"
      aria-labelledby="disciplines-title"
    >
      <div class="site-container py-8 md:py-10">
        <div class="mb-7 flex flex-col gap-3 md:mb-9 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="mb-3 text-xs font-semibold tracking-[0.16em] text-muted uppercase">
              Áreas de trabajo
            </p>
            <SplitText
              as="h2"
              id="disciplines-title"
              class="max-w-145 font-display text-[22px] leading-[1.2] font-medium tracking-[-0.8px] md:text-[28px]"
              lines={["Seguridad pensada de principio a fin."]}
            />
          </div>
          <p class="max-w-85 text-xs leading-[1.75] text-muted md:text-[13px]">
            Diseñamos cada parte para que la tecnología funcione y el espacio
            también se sienta bien.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-x-5 gap-y-7 sm:grid-cols-2 lg:grid-cols-5 lg:gap-y-0">
          {
            disciplines.map((discipline, index) => (
              <article
                class="group border-t border-outline pt-4 lg:border-t-0 lg:border-l lg:pl-5"
                data-reveal
              >
                <div class="mb-5 text-xs font-semibold tracking-[0.16em] text-muted">
                  <span>0{index + 1}</span>
                </div>
                <h3 class="mb-2 text-[17px] leading-[1.25] tracking-[-0.3px]">
                  {discipline.title}
                </h3>
                <p class="text-xs leading-[1.7] text-muted">
                  {discipline.text}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="site-container grid grid-cols-1 gap-x-11.25 gap-y-7 py-17.5 md:grid-cols-2 md:gap-y-14 md:py-27 lg:gap-x-22.5"
      id="nosotros"
      aria-labelledby="about-title"
    >
      <div>
        <SectionLabel>Somos REDOPS</SectionLabel>
        <SplitText
          as="h2"
          id="about-title"
          lines={["La tranquilidad empieza", "con una buena instalación."]}
        />
      </div>
      <div class="pt-0 text-[13px] leading-[1.9] md:pt-2.25" data-reveal>
        <p
          class="mb-4 text-lg leading-normal text-content md:text-[19px]"
        >
          Tecnología que protege. Trabajo que se nota.
        </p>
        <p class="mt-3.25">
          En REDOPS conectamos la seguridad física con la digital. Instalamos
          sistemas de videovigilancia, trabajamos en la protección de redes y
          cuidamos la infraestructura que hace posible cada conexión.
        </p>
        <p class="mt-3.25">
          Nos ocupamos también de lo que no se ve: canalización, cableado y
          acabados para una instalación integrada a tu espacio.
        </p>
        <div
          class="mt-5.25 flex items-center gap-6.25 font-display text-[19px] font-bold text-content md:mt-6"
        >
          <small class="font-sans text-[10px] font-normal text-muted"
            >Trabajamos con</small
          ><span>HIKVISION</span><span>UNV</span>
        </div>
      </div>
      <div
        class="col-span-full mt-2.5 grid grid-cols-1 gap-7 md:mt-0 md:grid-cols-3 md:gap-8"
      >
        {
          areas.map((area) => (
            <article
              class="grid grid-cols-[50px_1fr] gap-x-4.5 gap-y-2 border-t border-outline pt-6.25 md:block md:gap-0 md:pt-7"
              data-reveal
            >
              <span
                class:list={[
                  "row-span-2 m-0 flex size-11.25 items-center justify-center rounded-[10px] border border-outline bg-surface md:row-span-1 md:mb-5.5 md:size-12.75",
                  area.iconColor,
                ]}
              >
                <Icon name={area.icon} size={26} />
              </span>
              <h3 class="m-0 text-[19px] md:mb-3">{area.title}</h3>
              <p class="max-w-none text-[13px] leading-[1.85] md:max-w-77.5">
                {area.text}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="border-y border-outline bg-surface"
      id="servicios"
      aria-labelledby="services-title"
    >
      <div
        class="site-container grid grid-cols-1 items-center gap-8.75 py-13.75 md:grid-cols-2 md:gap-7.5 md:py-20 lg:gap-18.75"
      >
        <ServiceGraphic />
        <div>
          <SectionLabel>Una solución de principio a fin</SectionLabel>
          <SplitText
            as="h2"
            id="services-title"
            class="text-[34px] md:text-[clamp(30px,3.2vw,42px)]"
            lines={["Protegemos lo importante.", "Cuidamos los detalles."]}
          />
          <p class="mt-5.75 max-w-110 text-[13px] leading-[1.9]" data-reveal>
            Una cámara es parte de un sistema. La red, el cableado y la
            instalación también cuentan. Trabajamos en cada parte para que todo
            encaje.
          </p>
          <ul class="mt-6 mb-7.25 grid list-none gap-0 border-t border-outline p-0">
            {
              services.map((service, index) => (
                <li data-reveal>
                  <a
                    class="group flex items-center gap-4 border-b border-outline py-4"
                    href="#contacto"
                  >
                    <span class="font-display text-[10px] font-semibold tracking-[0.16em] text-muted tabular-nums">
                      0{index + 1}
                    </span>
                    <span class="min-w-0 flex-1 text-[12px] leading-[1.6] text-muted md:text-[13px]">
                      {service}
                    </span>
                    <span class="grid size-9 shrink-0 place-items-center rounded-full border border-outline text-content transition-colors duration-200 group-hover:border-brand group-hover:bg-brand group-hover:text-white motion-reduce:transition-none">
                      <span class="transition-transform duration-300 group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0">
                        <Icon name="chevron" size={16} />
                      </span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <Button href="#contacto" variant="secondary"
            >Hablemos de tu proyecto <Icon name="arrow" size={18} /></Button
          >
        </div>
      </div>
    </section>

    <section
      class="site-container grid grid-cols-1 gap-8.75 py-14 md:grid-cols-[0.85fr_1.15fr] md:items-center md:gap-12.5 md:py-22.5 lg:gap-20"
      id="experto-proyectos"
      aria-labelledby="expert-title"
    >
      <div class="order-2 md:order-1" data-reveal>
        <div class="overflow-hidden rounded-xl border border-outline bg-surface">
          <Image
            src={expertImage}
            alt="Experto en proyectos tecnológicos de REDOPS frente a una red de servidores"
            format="webp"
            quality={84}
            class="aspect-3/4 w-full object-cover object-center"
          />
        </div>
      </div>
      <div class="order-1 md:order-2">
        <SectionLabel>Proyectos tecnológicos</SectionLabel>
        <p class="mt-3 mb-4 text-sm font-semibold text-content">Ing. Lenin Josué</p>
        <SplitText
          as="h2"
          id="expert-title"
          lines={["La tecnología necesita una visión completa."]}
        />
        <p class="mt-5.75 max-w-115 text-[13px] leading-[1.9]">
          Nuestro experto en proyectos tecnológicos convierte tus necesidades
          en soluciones claras: desde la conectividad y la fibra óptica hasta
          la infraestructura que mantiene todo funcionando.
        </p>
        <div class="mt-7 grid gap-4 border-t border-outline pt-5 sm:grid-cols-2">
          <div>
            <p class="mb-1 text-[12px] font-semibold text-content">Diseño</p>
            <p class="text-xs leading-[1.7]">
              Planeación técnica para que cada recurso tenga un propósito.
            </p>
          </div>
          <div>
            <p class="mb-1 text-[12px] font-semibold text-content">Implementación</p>
            <p class="text-xs leading-[1.7]">
              Redes, conectividad e infraestructura listas para crecer.
            </p>
          </div>
        </div>
        <a
          class="mt-7 inline-flex min-h-11 items-center gap-2 text-[12px] font-semibold text-content hover:text-accent-red"
          href="#contacto"
        >
          Hablemos de tu proyecto <Icon name="arrow" size={18} />
        </a>
      </div>
    </section>

    <Gallery />

    <section
      class="contact-glow site-container relative isolate mb-8.75 overflow-hidden rounded-[22px] border px-6 pt-6.75 pb-5 md:mb-15 md:rounded-[30px] md:px-11 md:pt-8.5 md:pb-5.5"
      id="contacto"
      aria-labelledby="contact-title"
    >
      <div class="flex items-start justify-between text-accent-red">
        <SectionLabel class="text-[10px] md:text-[11px]">
          Cuéntanos qué necesitas proteger
        </SectionLabel>
        <Icon name="globe" size={31} />
      </div>
      <div
        class="grid grid-cols-1 items-center gap-6 pt-3 pb-7.5 md:grid-cols-[1.2fr_1fr] md:gap-8.75 md:pt-3.75 md:pb-9.25 lg:gap-16.25"
      >
        <SplitText
          as="h2"
          id="contact-title"
          class="text-[35px] tracking-[-1.5px] md:text-[clamp(34px,4vw,50px)] md:tracking-[-2px]"
          lines={["Tu próximo proyecto.", "Más seguro desde el inicio."]}
        />
        <div data-reveal>
          <p
            class="mb-5.75 max-w-none text-[13px] leading-[1.9] md:max-w-87.5"
          >
            ¿Necesitas cámaras, mejorar la seguridad de tu red o una instalación
            completa? Cuéntanos tu idea y conversemos sobre la solución.
          </p>
          <Button id="contact-open">
            Solicitar información <Icon name="arrow" size={19} />
          </Button>
        </div>
      </div>
      <div
        class="flex items-center justify-between gap-3.75 border-t border-outline pt-4.75 text-[9px] text-muted md:gap-0 md:text-[10px]"
      >
        <span>Videovigilancia. Redes. Instalaciones.</span>
        <span>redop.org</span>
      </div>
    </section>
  </main>

  <Footer />
  <Dialogs />
  <script src="../scripts/interactions.ts"></script>
</Layout>

</Layout>
